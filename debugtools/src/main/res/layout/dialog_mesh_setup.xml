<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <!-- ========== Top title bar ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tv_dialog_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dialog_mesh_setup_title"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_status_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#666666"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- ========== Selection panel (create/join) ========== -->
    <LinearLayout
        android:id="@+id/ll_choice_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/dialog_mesh_select_operation"
            android:textColor="#333333"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:gravity="center"
            android:text="@string/dialog_mesh_select_desc"
            android:textColor="#999999"
            android:textSize="13sp" />

        <!-- Create network button -->
        <TextView
            android:id="@+id/btn_create_mesh"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="#4C55FF"
            android:gravity="center"
            android:text="@string/dialog_mesh_create_network"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Join network button -->
        <TextView
            android:id="@+id/btn_join_mesh"
            android:layout_width="240dp"
            android:layout_height="48dp"
            android:layout_marginBottom="32dp"
            android:background="#FF6B35"
            android:gravity="center"
            android:text="@string/dialog_mesh_join_network"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <!-- Back button -->
        <TextView
            android:id="@+id/btn_back_choice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="@string/dialog_mesh_back"
            android:textColor="#666666"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ========== Networking in progress panel ========== -->
    <LinearLayout
        android:id="@+id/ll_matching_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <!-- Status text -->
        <TextView
            android:id="@+id/tv_matching_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/dialog_mesh_in_progress"
            android:textColor="#333333"
            android:textSize="14sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#E0E0E0" />

        <!-- Device list title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dialog_mesh_discovered_devices"
            android:textColor="#666666"
            android:textSize="13sp" />

        <!-- Device list -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/ll_device_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Bottom buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_cancel_mesh"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#E0E0E0"
                android:gravity="center"
                android:text="@string/dialog_mesh_cancel"
                android:textColor="#333333"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_complete_mesh"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#4CAF50"
                android:gravity="center"
                android:text="@string/dialog_mesh_done"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
