<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/debug_light_gray2"
    android:orientation="vertical"
    android:padding="10dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ============ 1. Device status area ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/debug_shape_list_item_default_4"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/esim_title"
                        android:textColor="@color/debug_white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_refresh_status"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="@string/esim_refresh"
                        android:textAllCaps="false"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_eid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/esim_eid_default"
                    android:textColor="@color/debug_gray_light"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_card_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/esim_card_default"
                    android:textColor="@color/debug_gray_light"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_active_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/esim_active_profile_default"
                    android:textColor="@color/debug_gray_light"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ============ 2. SIM slot switch area ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/debug_shape_list_item_default_4"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/esim_section_slot"
                    android:textColor="@color/debug_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/esim_slot_hint"
                    android:textColor="@color/debug_gray_light"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_switch_to_sim"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/esim_switch_to_sim"
                        android:textAllCaps="false"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_switch_to_esim"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/esim_switch_to_esim"
                        android:textAllCaps="false"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 3. Profile management area ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/debug_shape_list_item_default_4"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/esim_section_profile"
                    android:textColor="@color/debug_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/esim_profile_hint"
                    android:textColor="@color/debug_gray_light"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spinner_iccid"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/debug_gray"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_get_profiles"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/esim_get_profiles"
                        android:textAllCaps="false"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_enable_profile"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/esim_enable_profile"
                        android:textAllCaps="false"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_disable_profile"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/esim_disable_profile"
                        android:textAllCaps="false"
                        android:textSize="12sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_delete_profile"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/esim_delete_profile"
                        android:textAllCaps="false"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 4. Number writing area ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/debug_shape_list_item_default_4"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/esim_section_download"
                    android:textColor="@color/debug_white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/esim_download_hint"
                    android:textColor="@color/debug_gray_light"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/esim_server_label"
                    android:textColor="@color/debug_gray_light"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spinner_smdp_server"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="2dp"
                    android:background="@color/debug_gray"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/esim_matching_id_label"
                    android:textColor="@color/debug_gray_light"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_matching_id"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@color/debug_gray"
                        android:hint="@string/esim_matching_id_hint"
                        android:inputType="textCapCharacters"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/debug_white"
                        android:textColorHint="@color/debug_color_97_97_97"
                        android:textSize="12sp"
                        tools:ignore="Autofill" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_download_profile"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/esim_write"
                        android:textAllCaps="false"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 5. Advanced debug area (collapsible) ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/debug_shape_list_item_default_4"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:id="@+id/layout_advanced_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/esim_section_advanced"
                        android:textColor="@color/debug_white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_advanced_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/esim_toggle_show"
                        android:textColor="@color/debug_color_2A83FB"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_advanced_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <Spinner
                        android:id="@+id/spinner_apdu_presets"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:background="@color/debug_gray"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/et_raw_apdu"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_weight="1"
                            android:background="@color/debug_gray"
                            android:hint="@string/esim_raw_apdu_hint"
                            android:inputType="textCapCharacters"
                            android:maxLines="1"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:textColor="@color/debug_white"
                            android:textColorHint="@color/debug_color_97_97_97"
                            android:textSize="12sp"
                            tools:ignore="Autofill" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_send_raw_apdu"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="4dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="@string/esim_send"
                            android:textAllCaps="false"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/esim_advanced_note"
                        android:textColor="@color/debug_color_97_97_97"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ============ 6. Operation guide (collapsible) ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/debug_shape_list_item_default_4"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:id="@+id/layout_guide_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/esim_section_guide"
                        android:textColor="@color/debug_white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_guide_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/esim_toggle_show"
                        android:textColor="@color/debug_color_2A83FB"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_guide_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/esim_guide_text"
                    android:textColor="@color/debug_gray_light"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- ============ 7. Log area ============ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/debug_shape_list_item_default_4"
                android:padding="8dp">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/scroll_log"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="32dp">

                    <TextView
                        android:id="@+id/tv_log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/debug_gray_light"
                        android:textIsSelectable="true"
                        android:textSize="11sp"
                        tools:text="log output..." />
                </androidx.core.widget.NestedScrollView>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_clear_log"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/esim_clear"
                    android:textAllCaps="false"
                    android:textSize="11sp" />
            </FrameLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
