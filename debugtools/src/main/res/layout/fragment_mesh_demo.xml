<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:orientation="vertical">

    <!-- ========== Top device selector bar ========== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#16213E"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_device_tabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </HorizontalScrollView>

    <!-- ========== Video display area ========== -->
    <LinearLayout
        android:id="@+id/ll_video_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Wide-angle view -->
        <FrameLayout
            android:id="@+id/fl_visible_video"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#000000">

            <com.autel.player.player.autelplayer.AutelPlayerView
                android:id="@+id/player_view_visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tv_visible_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="#80000000"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/mesh_lens_zoom"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_no_video_visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/debug_mesh_demo_no_video"
                android:textColor="#666666"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:id="@+id/divider_video"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="#333333" />

        <!-- IR view -->
        <FrameLayout
            android:id="@+id/fl_infrared_video"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#000000">

            <com.autel.player.player.autelplayer.AutelPlayerView
                android:id="@+id/player_view_infrared"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tv_infrared_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="#80000000"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/mesh_lens_thermal"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_no_video_infrared"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/debug_mesh_demo_no_video"
                android:textColor="#666666"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- ========== Video mode switch ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#16213E"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_dual_view"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="16dp"
            android:background="#334756"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/debug_mesh_demo_dual_screen"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_visible_only"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginEnd="16dp"
            android:background="#334756"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/debug_mesh_demo_visible_only"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_infrared_only"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="#334756"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/debug_mesh_demo_infrared_only"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ========== Bottom control panel ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F3460"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- Request control -->
        <TextView
            android:id="@+id/btn_request_control"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="#E94560"
            android:gravity="center"
            android:text="@string/debug_mesh_demo_request_control"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <!-- Downward light switch -->
        <TextView
            android:id="@+id/btn_down_light"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="#334756"
            android:gravity="center"
            android:text="@string/debug_mesh_demo_down_light_off"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <!-- Night light switch -->
        <TextView
            android:id="@+id/btn_night_light"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="#334756"
            android:gravity="center"
            android:text="@string/debug_mesh_demo_night_light_off"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ========== Status info ========== -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A2E"
        android:padding="6dp"
        android:text="@string/debug_mesh_demo_ready"
        android:textColor="#53BF9D"
        android:textSize="11sp" />

</LinearLayout>
