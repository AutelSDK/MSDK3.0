<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/debug_activity_background">

    <LinearLayout
        android:id="@+id/layout_top_controls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/debug_dimen_dp_12"
        android:paddingTop="@dimen/debug_dimen_dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/btn_start_recognize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/debug_recognition_start" />

        <RadioGroup
            android:id="@+id/lens_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/debug_dimen_dp_16"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_zoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:saveEnabled="false"
                android:text="@string/ai_demo_lens_zoom"
                tools:ignore="HardcodedText" />

            <RadioButton
                android:id="@+id/rb_thermal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:saveEnabled="false"
                android:text="@string/ai_demo_lens_thermal" />
        </RadioGroup>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_recognize_options"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/debug_dimen_dp_4"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/debug_dimen_dp_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_top_controls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_sound_alert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_demo_sound_alert"
                android:textColor="@color/debug_white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_toggle_target_types"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/debug_dimen_dp_12"
                android:layout_weight="1"
                android:text="@string/ai_demo_target_types_expand"
                android:textColor="@color/debug_color_4CAF50"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_clear_session_record"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/ai_demo_clear_session_record"
                android:textSize="11sp" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/layout_target_type_checks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_session_record_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ai_demo_session_record_empty"
            android:textColor="@color/debug_gray_light"
            android:textSize="11sp" />

        <ScrollView
            android:id="@+id/sv_session_record"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="72dp">

            <TextView
                android:id="@+id/tv_session_record"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/debug_gray_light"
                android:textSize="10sp"
                tools:text="10:52:13  id=1  Person  conf=0.92" />
        </ScrollView>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/player_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/debug_dimen_dp_8"
        app:layout_constraintBottom_toTopOf="@id/ai_status_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_recognize_options">

        <com.autel.player.player.autelplayer.AutelPlayerView
            android:id="@+id/player_view_zoom"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.autel.player.player.autelplayer.AutelPlayerView
            android:id="@+id/player_view_thermal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <include
        android:id="@+id/ai_status_panel"
        layout="@layout/layout_ai_demo_status_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
