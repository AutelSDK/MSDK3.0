<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/debug_mission_shape_bg_codec_default"
    android:orientation="vertical">

    <!-- Top control bar -->
    <LinearLayout
        android:id="@+id/control_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#333333"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tv_device_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/debug_ondemand_device_disconnected"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_gimbal_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/debug_ondemand_gimbal_default"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Lens selection tabs -->
    <HorizontalScrollView
        android:id="@+id/lens_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#222222"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/lens_tab_container"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

    </HorizontalScrollView>

    <!-- Video display area -->
    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Single-stream player view -->
        <FrameLayout
            android:id="@+id/single_player_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <!-- Multi-stream player view (grid layout) -->
        <LinearLayout
            android:id="@+id/multi_player_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/top_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/player_slot_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/player_slot_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bottom_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/player_slot_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/player_slot_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

            </LinearLayout>

        </LinearLayout>

        <!-- Loading hint -->
        <TextView
            android:id="@+id/tv_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#80000000"
            android:padding="16dp"
            android:text="@string/debug_ondemand_waiting_device"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="visible" />

        <!-- Watermark switch panel (overlay at the top-right of the video area) -->
        <LinearLayout
            android:id="@+id/watermark_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="#66000000"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_watermark_enable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/debug_watermark_total"
                android:textColor="@color/debug_white"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_watermark_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/debug_watermark_time"
                android:textColor="@color/debug_white"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_watermark_gps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/debug_watermark_gps"
                android:textColor="@color/debug_white"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_watermark_sn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/debug_watermark_sn"
                android:textColor="@color/debug_white"
                android:textSize="14sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_watermark_custom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/debug_watermark_custom"
                android:textColor="@color/debug_white"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Bottom status bar -->
    <LinearLayout
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="#333333"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tv_current_lens"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/debug_ondemand_current_lens_default"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_player_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/debug_ondemand_status_stopped"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <View
            android:layout_width="16dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btn_toggle_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:text="@string/debug_ondemand_single_view"
            android:textColor="#4CAF50"
            android:textSize="12sp" />

        <View
            android:layout_width="16dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btn_toggle_watermark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"
            android:text="@string/debug_watermark_effect"
            android:textColor="#FF9800"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
