<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F1F1"
    android:orientation="vertical">

    <!-- ========== Top title bar ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/im_info_sharing_title"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Connection status indicator -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E0E0E0"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="@string/im_disconnected"
            android:textColor="#666666"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- ========== Chat room status panel ========== -->
    <!-- Shows key info: mesh status, RTM connection state, chat room (channel) ID, conversation ID, local participant ID -->
    <LinearLayout
        android:id="@+id/ll_info_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0F4FF"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <!-- Row 1: mesh status + RTM connection status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_mesh_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/im_mesh_not_joined_label"
                android:textColor="#999999"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_rtm_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/im_rtm_not_initialized_label"
                android:textColor="#999999"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Row 2: channel/MeshID + conversation ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_channel_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/im_channel_id_empty"
                android:textColor="#666666"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_conversation_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/im_session_id_empty"
                android:textColor="#666666"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Row 3: local participant ID -->
        <TextView
            android:id="@+id/tv_local_user_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/im_local_user_empty"
            android:textColor="#666666"
            android:textSize="11sp" />

        <!-- Row 4: online participants list -->
        <TextView
            android:id="@+id/tv_participants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/im_participants_empty"
            android:textColor="#666666"
            android:textSize="11sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- ========== Device selector bar ========== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#FFFFFF"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_device_tabs"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- ========== Message list area ========== -->
    <ScrollView
        android:id="@+id/sv_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/ll_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp" />
    </ScrollView>

    <!-- ========== Telemetry sharing button bar ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/btn_share_telemetry"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="#4C55FF"
            android:gravity="center"
            android:text="@string/im_share_telemetry_btn"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_share_custom"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="#FF6B35"
            android:gravity="center"
            android:text="@string/im_send_custom_data_btn"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ========== Bottom input area ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F9F9F9"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <!-- Voice record button -->
        <TextView
            android:id="@+id/btn_voice"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:background="#E0E0E0"
            android:gravity="center"
            android:text="🎤"
            android:textSize="20sp" />

        <!-- Text input box -->
        <EditText
            android:id="@+id/et_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:hint="Enter message..."
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:textColor="#333333"
            android:textSize="14sp" />

        <!-- Send button -->
        <TextView
            android:id="@+id/btn_send"
            android:layout_width="60dp"
            android:layout_height="40dp"
            android:background="#4C55FF"
            android:gravity="center"
            android:text="@string/im_send_btn"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
